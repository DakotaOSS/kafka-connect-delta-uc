<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.dakotaoss</groupId>
  <artifactId>kafka-connect-delta-uc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Delta UC Sink Connector</name>
  <description>Kafka Connect sink that writes to Unity Catalog managed Delta tables using the Delta Kernel Java API (no Spark).</description>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <delta.kernel.version>4.2.0</delta.kernel.version>
    <kafka.version>3.8.1</kafka.version>
    <hadoop.version>3.4.2</hadoop.version>
    <jackson.version>2.21.4</jackson.version>
  </properties>

  <!-- Import the Jackson BOM so every jackson-* (incl. Hadoop's transitives) resolves in lockstep. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Pin the three transitives that otherwise diverge across the Kernel/Parquet/Hadoop/UC graph,
           to the highest version each path requests, so maven-enforcer's dependencyConvergence holds. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>1.7.36</version>
      </dependency>
      <dependency>
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>1.1.10.8</version>
      </dependency>
      <dependency>
        <groupId>commons-logging</groupId>
        <artifactId>commons-logging</artifactId>
        <version>1.3.6</version>
      </dependency>
      <!-- Parquet's compression lib (via delta-kernel-defaults -> parquet-hadoop 1.16.0); pinned past
           CVE-2025-67721 (info leak from reused buffers, fixed in 2.0.3). It's shipped (compile
           scope), so bump rather than suppress. Re-verify on a delta.kernel.version bump: newer
           Parquet may move to the io.airlift:aircompressor-v3 artifact, which this pin would not cover. -->
      <dependency>
        <groupId>io.airlift</groupId>
        <artifactId>aircompressor</artifactId>
        <version>2.0.3</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Delta Kernel: protocol + write/read APIs (no Spark). -->
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-kernel-api</artifactId>
      <version>${delta.kernel.version}</version>
    </dependency>
    <!-- Default Engine implementation (Hadoop-backed Parquet/JSON/FS I/O). -->
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-kernel-defaults</artifactId>
      <version>${delta.kernel.version}</version>
    </dependency>
    <!-- delta-storage ships the Unity Catalog commit-coordinator REST client
         (io.delta.storage.commit.uccommitcoordinator.*) used to ratify catalog-managed commits. -->
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-storage</artifactId>
      <version>${delta.kernel.version}</version>
    </dependency>
    <!-- The Unity Catalog OSS client SDK the UC commit client delegates to (DeltaCommitsApi etc.). -->
    <dependency>
      <groupId>io.unitycatalog</groupId>
      <artifactId>unitycatalog-client</artifactId>
      <version>0.4.1</version>
    </dependency>

    <!-- Kafka Connect API. Provided by the Connect runtime at deploy time. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>connect-api</artifactId>
      <version>${kafka.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Hadoop: Configuration (compile) + filesystem/ABFS drivers (runtime). -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-api</artifactId>
      <version>${hadoop.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-runtime</artifactId>
      <version>${hadoop.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Azure ADLS Gen2 driver (abfss://). Compile scope: we implement its SASTokenProvider
         extension (VendedSasTokenProvider) to vend per-table SAS without a JVM-global FS-cache disable. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-azure</artifactId>
      <version>${hadoop.version}</version>
      <!-- We only use ABFS (abfss://); drop the legacy WASB stack so its
           azure-storage/keyvault transitives aren't shipped or scanned. -->
      <exclusions>
        <exclusion>
          <groupId>com.microsoft.azure</groupId>
          <artifactId>azure-storage</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.microsoft.azure</groupId>
          <artifactId>azure-keyvault-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- hadoop-azure needs UNshaded commons-lang3; hadoop-client-runtime only ships a
         relocated copy (org.apache.hadoop.shaded.*), so provide the real one explicitly. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.20.0</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Same reason as commons-lang3: hadoop-azure's Parquet write path needs unshaded commons-io. -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.18.0</version>
      <scope>runtime</scope>
    </dependency>

    <!-- JSON for the Unity Catalog REST client. Versions come from the imported jackson-bom above. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- core+annotations declared so the BOM's version wins over Hadoop's older transitive ones. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <!-- Dependency governance: fail the build on version divergence or a banned (legacy/vulnerable)
           artifact in the large Hadoop transitive graph. Runs at validate, so it gates every build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[11,)</version>
                </requireJavaVersion>
                <dependencyConvergence/>
                <bannedDependencies>
                  <excludes>
                    <!-- log4j 1.x (EOL) and the log4shell-vulnerable log4j-core range -->
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core:(,2.17.0)</exclude>
                    <!-- commons-collections gadget-chain deserialization CVEs -->
                    <exclude>commons-collections:commons-collections:(,3.2.1]</exclude>
                    <!-- keep the CVE-2025-67721 fix: a transitive must not drag aircompressor back -->
                    <exclude>io.airlift:aircompressor:(,2.0.3)</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Emit a CycloneDX SBOM at package time (target/bom.json); CI scans it for CVEs with Trivy. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.1</version>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals><goal>makeAggregateBom</goal></goals>
          </execution>
        </executions>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
          <!-- The SBOM describes what the connector ships. provided deps (connect-api, kafka-clients,
               slf4j) are supplied by the Connect runtime and excluded from the plugin dir, so they're
               not part of our artifact's risk surface; test deps aren't shipped either. -->
          <includeProvidedScope>false</includeProvidedScope>
          <includeTestScope>false</includeTestScope>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
